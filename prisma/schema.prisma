// Prisma schema for pridiction-market.
// Auth models mirror the Desktop/posters setup (Auth.js + Prisma adapter).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//<--------- AUTHENTICATION MODELS----------->
enum Role {
  USER
  ADMIN
}

// TABLE-1
model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  role          Role            @default(USER)
  image         String?

  //Business Columns
  balance       Int             @default(0)
  //Business Related Relations
  walletEvents  WalletEvents[]
  createdMarkets Markets[]
  bets         Bets[]
  //Authentication Related Relations
  accounts      Account[]
  sessions      Session[]
  Authenticator Authenticator[] // Optional for WebAuthn support

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletEvents {
  id       String   @id @default(cuid())
  userId    String
  type      String
  amount    Int
  externalId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Markets {
  id          String   @id @default(cuid())
  creatorId   String
  title       String
  intialWager Int
  bet         Boolean  @default(false)
  expiry      DateTime
  resolution  String?
  bets       Bets[]

  user User @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt 
}

model Bets {
  id        String   @id @default(cuid())
  userId    String
  marketId  String
  amount    Int
  outcome   Boolean  
  resolution String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  market Markets @relation(fields: [marketId], references: [id], onDelete: Cascade)
}


// Authentication related models
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}
